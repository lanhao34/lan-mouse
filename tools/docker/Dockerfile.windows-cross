FROM rust:1.91.1-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc-mingw-w64-x86-64 g++-mingw-w64-x86-64 mingw-w64-tools \
    pkg-config libglib2.0-dev libssl-dev zstd python3 file ca-certificates \
    && rm -rf /var/lib/apt/lists/*
RUN rustup target add x86_64-pc-windows-gnu
COPY fetch-msys.py /usr/local/bin/fetch-msys.py
RUN python3 /usr/local/bin/fetch-msys.py
ENV CARGO_TARGET_X86_64_PC_WINDOWS_GNU_LINKER=x86_64-w64-mingw32-gcc \
    CC_x86_64_pc_windows_gnu=x86_64-w64-mingw32-gcc \
    AR_x86_64_pc_windows_gnu=x86_64-w64-mingw32-ar \
    PKG_CONFIG_ALLOW_CROSS=1 \
    PKG_CONFIG_LIBDIR_x86_64_pc_windows_gnu=/opt/windows/ucrt64/lib/pkgconfig:/opt/windows/ucrt64/share/pkgconfig \
    PKG_CONFIG_SYSROOT_DIR_x86_64_pc_windows_gnu=/opt/windows \
    CARGO_TARGET_DIR=/target \
    CARGO_BUILD_JOBS=2 \
    CARGO_PROFILE_RELEASE_LTO=false \
    CARGO_PROFILE_RELEASE_CODEGEN_UNITS=16
WORKDIR /src
CMD ["cargo","build","--release","--target","x86_64-pc-windows-gnu","--locked"]
